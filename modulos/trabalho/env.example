# Módulo Trabalho (ClickUp)
#
# Estas chaves entram no .env da RAIZ do Segundo Cérebro (ou no painel da
# Vercel). O módulo também aceita um .env próprio aqui dentro
# (modulos/trabalho/.env), útil se você quiser separar as chaves. O da raiz
# sempre vence: o carregador local nunca sobrescreve o que já existe.
#
# NÃO traga PORT nem HOST do projeto clickup-local. O Segundo Cérebro usa
# PORT=3333 e trocar isso quebra o app inteiro.

# --- Obrigatório ---
# ClickUp: Settings > Apps > API Token. Começa com pk_
CLICKUP_API_TOKEN=pk_

# --- Opcionais ---
# Restringe a um workspace só. Vazio = todos os que o token enxerga.
CLICKUP_TEAM_ID=

# Quanto tempo a listagem fica em cache antes de bater no ClickUp de novo.
CACHE_TTL_MS=60000

# READ_ONLY=1 desliga comentário e mudança de status pela tela.
READ_ONLY=0

# MOCK=1 sobe com dados de exemplo, sem precisar de token.
MOCK=0

# --- Groq ---
# GROQ_API_KEY o Segundo Cérebro já define; o módulo reaproveita a mesma.
# O modelo é lido em cascata: GROQ_MODEL_TRABALHO, GROQ_MODEL, GROQ_CHAT_MODEL.
# Só preencha se quiser um modelo diferente do que o app usa nos insights.
GROQ_MODEL_TRABALHO=
GROQ_TIMEOUT_MS=45000
