# Copie para ".env" (local) ou cadastre no painel da Vercel (producao).
# NUNCA comite o .env.

# --- Supabase (armazenamento: Postgres + pgvector) ---
# Settings > API Keys. Use a SECRET key (sb_secret_...), que roda so no servidor.
# (A antiga "service_role" ainda funciona, mas sera deprecada ate o fim de 2026.)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_coloque_aqui

# --- Embedding (Gemini text-embedding-004, 768 dims) ---
# Uma ou mais chaves (rodizio). Pegue em https://aistudio.google.com
GEMINI_API_KEYS=chave1,chave2
# ou uma so:
# GEMINI_API_KEY=coloque_sua_chave_aqui
MODELO_EMBEDDING=text-embedding-004
# Modelos do Gemini usados no insight (nao no embedding):
GEMINI_MODELOS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_THINKING=HIGH

# --- LLM (Groq): resumo, classificacao e relacoes ---
# Pegue em https://console.groq.com (API Keys).
GROQ_API_KEY=coloque_sua_chave_aqui
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# modelo menor usado no relink (classificacao simples):
GROQ_MODEL_RELINK=llama-3.1-8b-instant

# --- Sintonia do relacionamento ---
PISO_SIMILARIDADE=0.30
MAX_CANDIDATOS=10

# --- Acesso por PIN ---
# Vazio ou ausente: sistema aberto, como sempre foi.
# Preenchido: tudo que devolve dado exige o PIN. A casca (HTML/CSS/JS) continua
# publica, senao nao haveria onde digitar o PIN.
# Use 8 caracteres ou mais: PIN de 4 digitos e quebravel por tentativa e erro.
PIN_ACESSO=

# --- Porta (so local; a Vercel injeta a dela) ---
PORT=3333
