# Copie para ".env" (local) ou cadastre no painel da Vercel (producao).
# NUNCA comite o .env.

# --- Supabase (armazenamento: Postgres + pgvector) ---
# Settings > API Keys. Use a SECRET key (sb_secret_...), que roda so no servidor.
# (A antiga "service_role" ainda funciona, mas sera deprecada ate o fim de 2026.)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_coloque_aqui

# --- Embedding (Gemini text-embedding-004, 768 dims) ---
# Uma ou mais chaves (rodizio). Pegue em https://aistudio.google.com
GEMINI_API_KEYS=chave1,chave2
# ou uma so:
# GEMINI_API_KEY=coloque_sua_chave_aqui
MODELO_EMBEDDING=text-embedding-004
# Modelos do Gemini usados no insight (nao no embedding):
GEMINI_MODELOS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_THINKING=HIGH

# --- LLM (Groq): resumo, classificacao e relacoes ---
# Pegue em https://console.groq.com (API Keys).
GROQ_API_KEY=coloque_sua_chave_aqui
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# modelo menor usado no relink (classificacao simples):
GROQ_MODEL_RELINK=llama-3.1-8b-instant

# --- Sintonia do relacionamento ---
PISO_SIMILARIDADE=0.30
MAX_CANDIDATOS=10

# --- Acesso por PIN ---
# Vazio ou ausente: sistema aberto, como sempre foi.
# Preenchido: tudo que devolve dado exige o PIN. A casca (HTML/CSS/JS) continua
# publica, senao nao haveria onde digitar o PIN.
# Use 8 caracteres ou mais: PIN de 4 digitos e quebravel por tentativa e erro.
PIN_ACESSO=

# --- Porta (so local; a Vercel injeta a dela) ---
PORT=3333

# --- Modulo metas ---
# Usuario publico do Duolingo (o que aparece na URL do perfil).
DUOLINGO_USUARIO=

# --- Modulo TrendRadar ---
# Reaproveita automaticamente GEMINI_API_KEYS, GEMINI_MODELOS, GROQ_API_KEY,
# GROQ_CHAT_MODEL e PIN_ACESSO ja definidos acima no 2brain.
# Chaves opcionais apenas para enriquecimento externo (possui fallback local automatico):
SERPAPI_KEY=
NEWSAPI_KEY=
GNEWS_API_KEY=
# Radar vivo (coleta diaria). CRON_SECRET: a Vercel manda "Authorization: Bearer <valor>"
# no cron; sem ele a rota do cron fica desligada (503). Gere algo longo e aleatorio.
CRON_SECRET=
# Opcionais:
# RADAR_PERFIL=Quem vai usar as oportunidades (muda o filtro das descobertas)
# GROQ_MODEL_RADAR=openai/gpt-oss-120b
# RADAR_PISO_AFINIDADE=0.72

# --- Modulo Conversa (todas opcionais; os padroes ja funcionam) ---
# Modelos do Gemini so para a resposta do chat (primeiro da lista tenta primeiro;
# em caso de 404/erro cai para GEMINI_MODELOS). Um modelo mais forte aqui e a
# melhoria de qualidade mais barata que existe.
# GEMINI_MODELOS_CONVERSA=gemini-3.5-flash,gemini-2.5-flash
# Modelos Groq das etapas auxiliares:
# GROQ_MODEL_PLANEJADOR=openai/gpt-oss-120b
# GROQ_MODEL_RERANK=openai/gpt-oss-120b
# GROQ_MODEL_MEMORIA=openai/gpt-oss-120b
# Busca: piso de similaridade (cosseno) e folga relativa ao melhor resultado.
# Calibre olhando /conversa/api/diagnostico com perguntas suas.
# CONVERSA_PISO_SIM=0.5
# CONVERSA_FOLGA_SIM=0.1
# Orcamento de caracteres da evidencia no prompt:
# CONVERSA_ORCAMENTO_EVIDENCIA=14000
# Tetos de tempo (ms): planejador, rerank, cada ferramenta
# TETO_PLANEJADOR_MS=7000
# TETO_RERANK_MS=6000
# TETO_FERRAMENTA_MS=8000
# Feed de assuntos da tela inicial (GET /conversa/api/sugestoes):
# GROQ_MODEL_SUGESTOES=openai/gpt-oss-120b
# TETO_SUGESTOES_MS=12000

# --- MCP (endpoint /mcp para Claude, ChatGPT, Cursor...) ---
# Sem esta variavel o /mcp responde 503 (desligado). Gere: openssl rand -hex 32
# Quem tem este token le TODOS os seus dados: trate como senha.
MCP_TOKEN=
